DATABASE_URL=postgresql://user:password@localhost:5432/inos
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
PORT=3000
FRONTEND_URL=http://localhost:5173
AI_SERVER_URL=http://localhost:3001
INVITATION_TTL_DAYS=7
# SMTP (Gmail: https://myaccount.google.com/apppasswords 에서 앱 비밀번호 발급)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yunchan0339@gmail.com
SMTP_PASS=
MAIL_FROM="INOS <yunchan0339@gmail.com>"

# 오가니제이션 생성 신청 수신 메일
ADMIN_EMAIL=yunchan0339@gmail.com

# 모임 확정일에는 시각 정보가 없어, "3시간 전" 리마인더 계산 시 이 시각(24h)을 모임 시작으로 가정
MEETING_DEFAULT_HOUR=19

# Sentry (없으면 비활성)
SENTRY_DSN=

# 국립중앙도서관 서지정보(SEOJI, 도서 검색) — https://www.nl.go.kr/NL/contents/N31101010000.do 에서 발급
# 없으면 도서 검색 API만 503으로 응답하고 나머지 기능은 정상 동작
SEOJI_CERT_KEY=
# 기본값 https://www.nl.go.kr/seoji — 로컬 검증 시 스텁 서버로 바꿔 끼울 때만 사용
# SEOJI_BASE_URL=

# TMDB (영화 검색) — https://www.themoviedb.org/settings/api 에서 발급
# 없으면 영화 검색 API만 503으로 응답하고 나머지 기능은 정상 동작
TMDB_API_KEY=
# 기본값 https://api.themoviedb.org/3 — 로컬 검증 시 스텁 서버로 바꿔 끼울 때만 사용
# TMDB_BASE_URL=

# 알라딘 Open API (랜딩 서가의 인기 도서 10권) — https://www.aladin.co.kr/ttb/wblog_manage.aspx 에서 발급
# 없으면 /api/showcase 의 books 가 빈 배열로 내려가고 랜딩이 자체 폴백 목록을 보여준다
ALADIN_TTB_KEY=
# 비워두면 전체 베스트셀러. 국내도서 인문학만 뽑으려면 656
ALADIN_CATEGORY_ID=
