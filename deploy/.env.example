# EC2의 저장소 루트에 .env 로 복사해서 사용 (docker compose가 자동으로 읽음)

# 서비스 도메인 (A 레코드가 EC2 IP를 가리켜야 함. 도메인 없이 테스트하려면 ":80")
DOMAIN=inos.example.com

# DB
POSTGRES_PASSWORD=

# JWT — server와 ai-server가 공유. openssl rand -hex 64 로 생성
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth — Console에 https://<DOMAIN>/api/auth/google/callback 등록 필요
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# SMTP (Gmail 앱 비밀번호: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="INOS <you@example.com>"

# 오가니제이션 생성 신청 수신 메일
ADMIN_EMAIL=
