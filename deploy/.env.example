# EC2의 저장소 루트에 .env 로 복사해서 사용 (docker compose가 자동으로 읽음)

# API 서버 도메인 (A 레코드가 EC2 IP를 가리켜야 함. 도메인 없이 테스트하려면 ":80")
DOMAIN=inos-api.duckdns.org

# 프론트엔드 주소 (Vercel 배포 시 해당 URL, EC2에서 웹까지 서빙하면 https://<DOMAIN>)
# OAuth 리다이렉트, CORS, 메일 링크에 사용됨
FRONTEND_URL=https://inos.vercel.app

# DB
POSTGRES_PASSWORD=

# JWT — server와 ai-server가 공유. openssl rand -hex 64 로 생성
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth — Console에 https://<DOMAIN>/api/auth/google/callback 등록 필요
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# SMTP (Gmail 앱 비밀번호: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="INOS <you@example.com>"

# 오가니제이션 생성 신청 수신 메일
ADMIN_EMAIL=
