# EC2의 저장소 루트에 .env 로 복사해서 사용 (docker compose가 자동으로 읽음)

# API 서버 도메인 (A 레코드가 EC2 IP를 가리켜야 함. 도메인 없이 테스트하려면 ":80")
DOMAIN=inos-api.duckdns.org

# 프론트엔드 주소 (Vercel 배포 시 해당 URL, EC2에서 웹까지 서빙하면 https://<DOMAIN>)
# OAuth 리다이렉트, CORS, 메일 링크에 사용됨
FRONTEND_URL=https://inos.vercel.app

# DB
POSTGRES_PASSWORD=

# JWT — server와 ai-server가 공유. openssl rand -hex 64 로 생성
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth — Console에 https://<DOMAIN>/api/auth/google/callback 등록 필요
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# --- 작품 메타데이터 (선택) ---
# 비워두면 해당 검색 API만 503으로 응답하고, 모임 생성 시 제목/감독을 직접 입력하면 된다.
# TMDB(영화 포스터·감독·장르) — https://www.themoviedb.org/settings/api 에서 발급 (무료, 즉시)
TMDB_API_KEY=
# 국립중앙도서관 서지정보(도서 검색) — https://www.nl.go.kr/NL/contents/N31101010000.do 에서 발급 (무료, 승인 불필요)
SEOJI_CERT_KEY=

# SMTP (Gmail 앱 비밀번호: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="INOS <you@example.com>"

# 오가니제이션 생성 신청 수신 메일
ADMIN_EMAIL=

# --- 모니터링 (선택) ---
# Sentry 에러 트래킹 — sentry.io에서 프로젝트별 DSN 발급 (없으면 비활성)
SERVER_SENTRY_DSN=
AI_SENTRY_DSN=

# Grafana Cloud Loki 로그 수집 — `docker compose --profile logging up -d` 로 활성화
# Grafana Cloud → Loki 스택의 host/user/token
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=
