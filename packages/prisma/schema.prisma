generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum OAuthProvider {
  GOOGLE
}

enum GroupMode {
  GROUP
  SOLO
}

enum GroupRole {
  LEADER
  MEMBER
}

enum ContentType {
  MOVIE
  BOOK
}

enum ContentSource {
  TMDB
  KAKAO
  GOOGLE_BOOKS
  USER_ADDED
}

enum GroupContentStatus {
  VOTING
  SELECTED
  COMPLETED
  CANCELLED
}

enum UserContentStatus {
  COMPLETED
  IN_PROGRESS
  WISHLIST
}

enum MeetingStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

enum DiscussionStatus {
  GENERATING
  GENERATED
  PUBLISHED
}

model User {
  id              String                      @id @default(uuid()) @db.Uuid
  email           String                      @unique
  nickname        String
  profileImageUrl String?
  oauthProvider   OAuthProvider
  oauthId         String
  tasteProfile    Json?
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  groupMembers     GroupMember[]
  contentVotes     ContentVote[]
  meetingAvails    MeetingAvailability[]
  discussionNotes  DiscussionNote[]
  userContents     UserContent[]
  archives         Archive[]
  selectedContents GroupContent[]             @relation("SelectedBy")

  @@unique([oauthProvider, oauthId])
  @@index([email])
  @@map("users")
}

model Group {
  id             String                      @id @default(uuid()) @db.Uuid
  ownerId        String                      @db.Uuid
  name           String
  description    String?
  inviteCode     String                      @unique @default(uuid())
  mode           GroupMode                   @default(GROUP)
  tasteProfile   Json?
  groupEmbedding Unsupported("vector(1536)")?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  members       GroupMember[]
  groupContents GroupContent[]
  meetings      Meeting[]
  archives      Archive[]
  discussions   Discussion[]

  @@index([inviteCode])
  @@map("groups")
}

model GroupMember {
  id       String    @id @default(uuid()) @db.Uuid
  groupId  String    @db.Uuid
  userId   String    @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model Content {
  id           String        @id @default(uuid()) @db.Uuid
  type         ContentType
  title        String
  creator      String
  releaseYear  Int?
  thumbnailUrl String?
  synopsis     String?       @db.Text
  metadata     Json?
  source       ContentSource @default(USER_ADDED)
  sourceId     String?
  isSeeded     Boolean       @default(false)
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime      @default(now())

  groupContents GroupContent[]
  userContents  UserContent[]

  @@unique([source, sourceId])
  @@index([type])
  @@index([title])
  @@map("contents")
}

model GroupContent {
  id          String             @id @default(uuid()) @db.Uuid
  groupId     String             @db.Uuid
  contentId   String             @db.Uuid
  status      GroupContentStatus @default(VOTING)
  selectedBy  String?            @db.Uuid
  selectedAt  DateTime           @default(now())
  completedAt DateTime?

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  content  Content  @relation(fields: [contentId], references: [id])
  selector User?    @relation("SelectedBy", fields: [selectedBy], references: [id])

  votes       ContentVote[]
  meetings    Meeting[]
  discussions Discussion[]

  @@unique([groupId, contentId])
  @@index([groupId, status])
  @@map("group_contents")
}

model ContentVote {
  id             String   @id @default(uuid()) @db.Uuid
  groupContentId String   @db.Uuid
  userId         String   @db.Uuid
  liked          Boolean  @default(true)
  votedAt        DateTime @default(now())

  groupContent GroupContent @relation(fields: [groupContentId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupContentId, userId])
  @@map("content_votes")
}

model UserContent {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  contentId   String            @db.Uuid
  status      UserContentStatus @default(IN_PROGRESS)
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId])
  @@index([userId, status])
  @@map("user_contents")
}

model Meeting {
  id             String        @id @default(uuid()) @db.Uuid
  groupId        String        @db.Uuid
  groupContentId String        @db.Uuid
  confirmedDate  DateTime?
  location       String?
  status         MeetingStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupContent GroupContent @relation(fields: [groupContentId], references: [id])

  availabilities MeetingAvailability[]
  discussion     Discussion?
  summary        MeetingSummary?
  archives       Archive[]

  @@index([groupId, status])
  @@map("meetings")
}

model MeetingAvailability {
  id             String   @id @default(uuid()) @db.Uuid
  meetingId      String   @db.Uuid
  userId         String   @db.Uuid
  availableDates Json
  respondedAt    DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@map("meeting_availabilities")
}

model Discussion {
  id               String           @id @default(uuid()) @db.Uuid
  meetingId        String           @unique @db.Uuid
  groupId          String           @db.Uuid
  groupContentId   String           @db.Uuid
  webSearchContext String?          @db.Text
  ragContext       String?          @db.Text
  generatedBody    String?          @db.Text
  editedBody       String?          @db.Text
  status           DiscussionStatus @default(GENERATING)
  generatedAt      DateTime?
  publishedAt      DateTime?

  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id])
  groupContent GroupContent @relation(fields: [groupContentId], references: [id])

  notes DiscussionNote[]

  @@index([groupId])
  @@map("discussions")
}

model DiscussionNote {
  id            String    @id @default(uuid()) @db.Uuid
  discussionId  String    @db.Uuid
  userId        String    @db.Uuid
  questionIndex Int
  content       String    @db.Text
  isPublic      Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId, questionIndex])
  @@index([discussionId, questionIndex])
  @@map("discussion_notes")
}

model MeetingSummary {
  id            String   @id @default(uuid()) @db.Uuid
  meetingId     String   @unique @db.Uuid
  transcriptRaw String?  @db.Text
  summary       String?  @db.Text
  keyInsights   Json?
  createdAt     DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_summaries")
}

model Archive {
  id         String   @id @default(uuid()) @db.Uuid
  meetingId  String   @db.Uuid
  groupId    String   @db.Uuid
  userId     String   @db.Uuid
  body       String?  @db.Text
  photoUrls  Json?
  archivedAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([groupId, archivedAt])
  @@map("archives")
}
