generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OAuthProvider {
  GOOGLE
}

enum GroupRole {
  OWNER
  MEMBER
}

enum MeetingStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

enum DiscussionStatus {
  GENERATING
  GENERATED
  PUBLISHED
}

enum PromptKind {
  BOOK
  MOVIE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  nickname        String
  profileImageUrl String?
  oauthProvider   OAuthProvider
  oauthId         String
  isAdmin         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  groupMembers    GroupMember[]
  ownedGroups     Group[]               @relation("GroupOwner")
  meetingAvails   MeetingAvailability[]
  discussionNotes DiscussionNote[]
  createdMeetings Meeting[]             @relation("MeetingCreatedBy")
  sentInvitations Invitation[]          @relation("InvitationInvitedBy")

  @@unique([oauthProvider, oauthId])
  @@index([email])
  @@map("users")
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  name        String
  description String?
  greeting    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id])
  members     GroupMember[]
  meetings    Meeting[]
  discussions Discussion[]
  invitations Invitation[]

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id       String    @id @default(uuid()) @db.Uuid
  groupId  String    @db.Uuid
  userId   String    @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Meeting {
  id            String        @id @default(uuid()) @db.Uuid
  groupId       String        @db.Uuid
  createdById   String        @db.Uuid
  bookTitle     String?
  bookAuthor    String?
  movieTitle    String?
  movieDirector String?
  confirmedDate DateTime?
  location      String?
  status        MeetingStatus @default(PENDING)
  candidateFrom DateTime
  candidateTo   DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  group          Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation("MeetingCreatedBy", fields: [createdById], references: [id])
  availabilities MeetingAvailability[]
  discussion     Discussion?

  @@index([groupId, status])
  @@index([groupId, confirmedDate])
  @@map("meetings")
}

model MeetingAvailability {
  id             String   @id @default(uuid()) @db.Uuid
  meetingId      String   @db.Uuid
  userId         String   @db.Uuid
  availableDates Json
  respondedAt    DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@map("meeting_availabilities")
}

model Discussion {
  id           String           @id @default(uuid()) @db.Uuid
  meetingId    String           @unique @db.Uuid
  groupId      String           @db.Uuid
  bookPrompts  Json?
  moviePrompts Json?
  bookContext  String?          @db.Text
  movieContext String?          @db.Text
  status       DiscussionStatus @default(GENERATING)
  generatedAt  DateTime?
  publishedAt  DateTime?

  meeting Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  group   Group            @relation(fields: [groupId], references: [id])
  notes   DiscussionNote[]

  @@index([groupId])
  @@map("discussions")
}

model DiscussionNote {
  id            String     @id @default(uuid()) @db.Uuid
  discussionId  String     @db.Uuid
  userId        String     @db.Uuid
  promptKind    PromptKind
  questionIndex Int
  content       String     @db.Text
  isPublic      Boolean    @default(false)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId, promptKind, questionIndex])
  @@index([discussionId, promptKind, questionIndex])
  @@map("discussion_notes")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  groupId     String           @db.Uuid
  email       String
  token       String           @unique
  invitedById String           @db.Uuid
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@unique([groupId, email])
  @@index([token])
  @@index([groupId, status])
  @@map("invitations")
}
