generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OAuthProvider {
  GOOGLE
  LOCAL
}

enum GroupRole {
  OWNER
  MEMBER
}

enum MeetingStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

enum DiscussionStatus {
  GENERATING
  GENERATED
  PUBLISHED
}

enum PromptKind {
  BOOK
  MOVIE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  nickname        String
  profileImageUrl String?
  oauthProvider   OAuthProvider
  oauthId         String
  passwordHash    String? // 로컬 로그인 계정만 사용 (bcrypt)
  isAdmin         Boolean       @default(false)
  libraryShareId  String?       @unique // 공개 서가 공유 링크 슬러그 (null이면 비공개)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  groupMembers           GroupMember[]
  ownedGroups            Group[]                 @relation("GroupOwner")
  meetingAvails          MeetingAvailability[]
  discussionNotes        DiscussionNote[]
  createdMeetings        Meeting[]               @relation("MeetingCreatedBy")
  sentInvitations        Invitation[]            @relation("InvitationInvitedBy")
  personalLibraryReviews PersonalLibraryReview[]
  updatedGroupReviews    GroupLibraryReview[]    @relation("GroupReviewUpdatedBy")
  manualLibraryEntries   ManualLibraryEntry[]
  groupPosts             GroupPost[]
  groupPostLikes         GroupPostLike[]
  createdInviteLinks     GroupInviteLink[]       @relation("InviteLinkCreatedBy")
  customPrompts          DiscussionCustomPrompt[]
  impressions            DiscussionImpression[]

  @@unique([oauthProvider, oauthId])
  @@index([email])
  @@map("users")
}

model Group {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @db.Uuid
  name           String
  description    String?
  greeting       String?
  libraryShareId String?  @unique // 오가니제이션 서가 공개 링크 슬러그 (null이면 비공개)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id])
  members     GroupMember[]
  meetings    Meeting[]
  discussions Discussion[]
  invitations Invitation[]
  posts       GroupPost[]
  inviteLinks GroupInviteLink[]

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id       String    @id @default(uuid()) @db.Uuid
  groupId  String    @db.Uuid
  userId   String    @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Meeting {
  id            String        @id @default(uuid()) @db.Uuid
  groupId       String        @db.Uuid
  createdById   String        @db.Uuid
  bookTitle     String?
  bookAuthor    String?
  movieTitle    String?
  movieDirector String?
  confirmedDate DateTime?
  location      String?
  status        MeetingStatus @default(PENDING)
  candidateFrom DateTime
  candidateTo   DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  group           Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("MeetingCreatedBy", fields: [createdById], references: [id])
  availabilities  MeetingAvailability[]
  discussion      Discussion?
  personalReviews PersonalLibraryReview[]
  groupReviews    GroupLibraryReview[]

  @@index([groupId, status])
  @@index([groupId, confirmedDate])
  @@map("meetings")
}

model MeetingAvailability {
  id             String   @id @default(uuid()) @db.Uuid
  meetingId      String   @db.Uuid
  userId         String   @db.Uuid
  availableDates Json
  timeNote       String?  @db.VarChar(80) // 선호 시간 메모 (예: "저녁 7시 이후")
  respondedAt    DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@map("meeting_availabilities")
}

model Discussion {
  id           String           @id @default(uuid()) @db.Uuid
  meetingId    String           @unique @db.Uuid
  groupId      String           @db.Uuid
  bookPrompts  Json?
  moviePrompts Json?
  bookContext  String?          @db.Text
  movieContext String?          @db.Text
  status       DiscussionStatus @default(GENERATING)
  generatedAt  DateTime?
  publishedAt  DateTime?

  meeting       Meeting                  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  group         Group                    @relation(fields: [groupId], references: [id])
  notes         DiscussionNote[]
  customPrompts DiscussionCustomPrompt[]
  impressions   DiscussionImpression[]

  @@index([groupId])
  @@map("discussions")
}

// 멤버가 직접 추가하는 자체 발제 질문
model DiscussionCustomPrompt {
  id           String     @id @default(uuid()) @db.Uuid
  discussionId String     @db.Uuid
  userId       String     @db.Uuid
  promptKind   PromptKind
  content      String     @db.VarChar(500)
  noteIndex    Int // 노트 키(100번대, 삭제돼도 재사용 안 함 — 위치가 아닌 고정값)
  createdAt    DateTime   @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId, promptKind, createdAt])
  @@map("discussion_custom_prompts")
}

// 모임 페이지 최하단의 사용자별 작품 감상 (선택)
model DiscussionImpression {
  id           String   @id @default(uuid()) @db.Uuid
  discussionId String   @db.Uuid
  userId       String   @db.Uuid
  content      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@map("discussion_impressions")
}

model DiscussionNote {
  id            String     @id @default(uuid()) @db.Uuid
  discussionId  String     @db.Uuid
  userId        String     @db.Uuid
  promptKind    PromptKind
  questionIndex Int
  content       String     @db.Text
  isPublic      Boolean    @default(false)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId, promptKind, questionIndex])
  @@index([discussionId, promptKind, questionIndex])
  @@map("discussion_notes")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  groupId     String           @db.Uuid
  email       String
  token       String           @unique
  invitedById String           @db.Uuid
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@unique([groupId, email])
  @@index([token])
  @@index([groupId, status])
  @@map("invitations")
}

// 개인 라이브러리 리뷰 — 별점(1~10, 0.5단위 표현용) + 한줄평. 작성자 본인만 수정 가능.
model PersonalLibraryReview {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  meetingId String     @db.Uuid
  kind      PromptKind
  rating    Int
  comment   String?    @db.VarChar(100)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([userId, meetingId, kind])
  @@index([meetingId, kind])
  @@map("personal_library_reviews")
}

// 개인 서재 수기 등록 — 모임 없이 직접 추가한 책/영화 (내장 별점·한줄평·발제문 포함)
model ManualLibraryEntry {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  kind           PromptKind
  title          String
  creator        String?
  finishedAt     DateTime?
  rating         Int? // 1~10 (0.5개 단위)
  comment        String?    @db.VarChar(100)
  discussionText String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("manual_library_entries")
}

// 오가니제이션 단위 리뷰 — 그룹당 작품 하나. 멤버 누구나 작성/수정 가능, 마지막 수정자만 기록.
model GroupLibraryReview {
  id          String     @id @default(uuid()) @db.Uuid
  meetingId   String     @db.Uuid
  kind        PromptKind
  rating      Int
  comment     String?    @db.VarChar(100)
  updatedById String     @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  updatedBy User    @relation("GroupReviewUpdatedBy", fields: [updatedById], references: [id])

  @@unique([meetingId, kind])
  @@map("group_library_reviews")
}

// 오가니제이션 게시판 — 하고싶은 말 (마크다운 본문)
model GroupPost {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  authorId  String   @db.Uuid
  title     String   @db.VarChar(100)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group  Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  GroupPostLike[]

  @@index([groupId, createdAt(sort: Desc)])
  @@map("group_posts")
}

model GroupPostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("group_post_likes")
}

// 오가니제이션 링크 초대 — 그룹당 활성 링크 1개, 링크를 아는 로그인 사용자는 누구나 참여
model GroupInviteLink {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @db.Uuid
  token       String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime
  revokedAt   DateTime?
  useCount    Int       @default(0)
  createdAt   DateTime  @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteLinkCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt(sort: Desc)])
  @@map("group_invite_links")
}
